# CajaClara backend — parámetros NO secretos (sí se versiona).
# Las credenciales van en .env (ver example.env). Las variables de entorno reales tienen prioridad
# sobre este archivo y sobre .env (docker compose sobreescribe POSTGRES_HOST=db).

# --- Aplicación ---
APP_ENV=local
TZ=America/Lima
# "Hoy" de la demo: todos los cálculos usan core/reloj.hoy(). Dejar vacío para usar la fecha real.
FECHA_DEMO=2026-11-14
API_PREFIX=/api/v1
API_VERSION=1.0.0
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Base de datos (la contraseña vive en .env) ---
# Fuera de docker se usa el puerto publicado en el host (5433); dentro de compose el backend usa db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cajaclara
POSTGRES_TEST_DB=cajaclara_test

# --- LLM (OpenRouter, API compatible con OpenAI) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_S=20
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
# Cabeceras opcionales de OpenRouter para identificar la app.
LLM_APP_URL=http://localhost:5173
LLM_APP_NAME=CajaClara
# Trazabilidad: cada llamada al LLM/VLM queda en la tabla llm_llamadas (tokens, costo, latencia, estado, modelo).
# LLM_TRAZA_GUARDAR_CONTENIDO=false guarda solo metadatos/tokens, sin messages ni respuesta (privacidad).
# Las imágenes nunca se guardan: solo sha256, bytes y mime.
LLM_TRAZA_ACTIVA=true
LLM_TRAZA_GUARDAR_CONTENIDO=true

# --- Visión: lectura de la foto del cuaderno de fiados (mismo OpenRouter y OPENROUTER_API_KEY) ---
# Cualquier modelo con entrada de imagen de OpenRouter sirve (p. ej. google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku).
# El tamaño máximo de la foto es MEDIA_MAX_IMAGEN_BYTES. La foto viaja al proveedor como data URL base64.
VLM_MODEL=openai/gpt-4o-mini
VLM_TIMEOUT_S=30
VLM_MAX_TOKENS=1500

# --- Whisper (faster-whisper local; el modelo se carga recién en la primera transcripción) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
# Carpeta de caché de modelos. Vacío = caché por defecto de Hugging Face. En docker: /models/whisper.
WHISPER_CACHE_DIR=

# --- Ingesta ---
# Por debajo de esta confianza el borrador lleva pregunta_aclaratoria.
UMBRAL_CONFIANZA=0.75
# Carpeta (relativa a backend/) de donde se leen audios y fotos de media_url (file://data/..., demo://...).
MEDIA_DIR=data

# --- Media en Cloudflare R2 (subida directa con URL prefirmada; las claves R2_* van en .env) ---
# Account ID de Cloudflare (R2 > Overview). Vacío = R2 sin configurar: POST /media/subidas responde 503.
R2_ACCOUNT_ID=c5149fae22eac69d24c6e467b3b36740
R2_BUCKET=hackathonbbvagrupo7
# Vigencia de la URL prefirmada de subida (segundos).
R2_PRESIGN_TTL_S=600
MEDIA_MAX_AUDIO_BYTES=10485760
MEDIA_MAX_IMAGEN_BYTES=8388608
MEDIA_TIPOS_AUDIO=audio/ogg,audio/webm,audio/mpeg,audio/mp4,audio/wav
MEDIA_TIPOS_IMAGEN=image/jpeg,image/png,image/webp

# --- Asistente ---
# true = el LLM redacta la respuesta con las cifras de las herramientas (se verifican); false = solo plantillas.
ASISTENTE_USAR_LLM=true

# --- Modelos de ML (artefactos del equipo de datos, solo lectura) ---
# Carpeta con forecast/ y credit_scoring/. Vacío = ../modelo/artifacts (relativo a backend/). En docker compose se
# monta ../modelo/artifacts en /app/ml/artifacts (ver docker-compose.yml). El backend solo lee metadata.json para
# decidir si el modelo es integrable; si no, usa el baseline determinístico (meta.fallback_usado = true).
ML_ARTIFACTS_DIR=
