# TuCaserito backend — parámetros NO secretos (sí se versiona).
# Las credenciales van en .env (ver example.env). Las variables de entorno reales tienen prioridad
# sobre este archivo y sobre .env (docker compose sobreescribe POSTGRES_HOST=db).

# --- Aplicación ---
APP_ENV=local
TZ=America/Lima
# "Hoy" de la demo: todos los cálculos usan core/reloj.hoy(). Dejar vacío para usar la fecha real.
FECHA_DEMO=2026-11-14
API_PREFIX=/api/v1
API_VERSION=1.0.0
# Orígenes permitidos para CORS, separados por coma (local: el dev server del front; Render: ver render.yaml).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Login de las demos (contract.md §12) ---
# Usuario interno → empresa (no secreto). El login y el hash de la contraseña de cada usuario interno son credenciales:
# AUTH_CREDENCIALES en .env (USR-xx:<login>:<hash>; ver example.env). Para cambiar la empresa de una demo basta con
# cambiarla aquí (y redesplegar): los tokens ya emitidos para la empresa anterior dejan de servir.
AUTH_USUARIOS=USR-01:EMP-0001,USR-02:EMP-0003,USR-03:EMP-0002
# Vigencia del token (segundos): 8 h.
AUTH_TOKEN_TTL_S=28800
# Fallos de login por IP: como mucho AUTH_LOGIN_MAX_FALLOS en AUTH_LOGIN_VENTANA_S; luego 429 + Retry-After.
AUTH_LOGIN_MAX_FALLOS=10
AUTH_LOGIN_VENTANA_S=600
# Rutas que gastan LLM/VLM/Whisper/R2 (ingesta, chat, asistente, webhook, media) con un token de demo: como mucho
# AUTH_IA_MAX_POR_SESION usos por sesión y AUTH_IA_MAX_POR_USUARIO por usuario (todas sus sesiones) en
# AUTH_IA_VENTANA_S. La X-API-Key (bot/admin) no tiene este límite.
AUTH_IA_MAX_POR_SESION=60
AUTH_IA_MAX_POR_USUARIO=200
AUTH_IA_VENTANA_S=3600
# Cabecera con la IP real del cliente puesta por un proxy de confianza. Vacío = IP de la conexión TCP (local: no se
# puede falsificar con cabeceras). Render la fija en CF-Connecting-IP (render.yaml). X-Forwarded-For nunca se usa.
IP_CLIENTE_CABECERA=

# --- Base de datos (la contraseña vive en .env) ---
# Fuera de docker se usa el puerto publicado en el host (5433); dentro de compose el backend usa db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cajaclara
POSTGRES_TEST_DB=cajaclara_test

# --- LLM (OpenRouter, API compatible con OpenAI) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_S=20
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
# Cabeceras opcionales de OpenRouter para identificar la app.
LLM_APP_URL=http://localhost:5173
LLM_APP_NAME=TuCaserito
# Trazabilidad: cada llamada al LLM/VLM queda en la tabla llm_llamadas (tokens, costo, latencia, estado, modelo).
# LLM_TRAZA_GUARDAR_CONTENIDO=false guarda solo metadatos/tokens, sin messages ni respuesta (privacidad).
# Las imágenes nunca se guardan: solo sha256, bytes y mime.
LLM_TRAZA_ACTIVA=true
LLM_TRAZA_GUARDAR_CONTENIDO=true

# --- Visión: lectura de la foto del cuaderno de fiados (mismo OpenRouter y OPENROUTER_API_KEY) ---
# Cualquier modelo con entrada de imagen de OpenRouter sirve (p. ej. google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku).
# El tamaño máximo de la foto es MEDIA_MAX_IMAGEN_BYTES. La foto viaja al proveedor como data URL base64.
VLM_MODEL=openai/gpt-4o-mini
VLM_TIMEOUT_S=30
VLM_MAX_TOKENS=1500

# --- Whisper (faster-whisper local; el modelo se carga recién en la primera transcripción) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
# Carpeta de caché de modelos. Vacío = caché por defecto de Hugging Face. En docker: /models/whisper.
WHISPER_CACHE_DIR=

# --- Ingesta ---
# Por debajo de esta confianza el borrador lleva pregunta_aclaratoria.
UMBRAL_CONFIANZA=0.75
# Carpeta (relativa a backend/) de donde se leen audios y fotos de media_url (file://data/..., demo://...).
MEDIA_DIR=data

# --- Media en Cloudflare R2 (subida directa con URL prefirmada; las claves R2_* van en .env) ---
# Account ID de Cloudflare (R2 > Overview). Vacío = R2 sin configurar: POST /media/subidas responde 503.
R2_ACCOUNT_ID=c5149fae22eac69d24c6e467b3b36740
R2_BUCKET=hackathonbbvagrupo7
# Vigencia de la URL prefirmada de subida (segundos).
R2_PRESIGN_TTL_S=600
MEDIA_MAX_AUDIO_BYTES=10485760
MEDIA_MAX_IMAGEN_BYTES=8388608
MEDIA_TIPOS_AUDIO=audio/ogg,audio/webm,audio/mpeg,audio/mp4,audio/wav
MEDIA_TIPOS_IMAGEN=image/jpeg,image/png,image/webp

# --- Asistente ---
# true = el LLM redacta la respuesta con las cifras de las herramientas (se verifican); false = solo plantillas.
ASISTENTE_USAR_LLM=true

# --- Modelos de ML (artefactos del equipo de datos, solo lectura) ---
# Carpeta con prediccion_ingreso_egreso/ y credit_scoring/. Vacío = ../modelo/artifacts (relativo a backend/). La imagen
# de docker (local y Render) trae una copia en /app/ml/artifacts (ENV del Dockerfile); compose monta ../modelo/artifacts
# encima para probar artefactos nuevos sin reconstruir. Los modelos se cargan una sola vez, en el primer uso o en /health.
ML_ARTIFACTS_DIR=
# Motor del forecast: lightgbm (modelo real; si no carga o no hay 30 días de historia usa el baseline con
# meta.fallback_usado = true y meta.fallback_motivo) | baseline (naive estacional, determinístico).
FORECAST_MOTOR=lightgbm

# --- Datos de demostración (CSV del equipo de datos) ---
# Carpeta con los CSV que carga `python -m app.db.cargar_csv`. Vacío = ../data/csv (relativo a backend/). En docker
# compose se monta ../data/csv en /app/data_csv (solo lectura) y se fija DATA_CSV_DIR=/app/data_csv.
DATA_CSV_DIR=
