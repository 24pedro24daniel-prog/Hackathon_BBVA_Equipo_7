# CajaClara backend — parámetros NO secretos (sí se versiona).
# Las credenciales van en .env (ver example.env). Las variables de entorno reales tienen prioridad
# sobre este archivo y sobre .env (docker compose sobreescribe POSTGRES_HOST=db).

# --- Aplicación ---
APP_ENV=local
TZ=America/Lima
# "Hoy" de la demo: todos los cálculos usan core/reloj.hoy(). Dejar vacío para usar la fecha real.
FECHA_DEMO=2026-11-14
API_PREFIX=/api/v1
API_VERSION=1.0.0
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Base de datos (la contraseña vive en .env) ---
# Fuera de docker se usa el puerto publicado en el host (5433); dentro de compose el backend usa db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cajaclara
POSTGRES_TEST_DB=cajaclara_test

# --- LLM (OpenRouter, API compatible con OpenAI) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_S=20
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
# Cabeceras opcionales de OpenRouter para identificar la app.
LLM_APP_URL=http://localhost:5173
LLM_APP_NAME=CajaClara

# --- Whisper (faster-whisper local; el modelo se carga recién en la primera transcripción) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es
# Carpeta de caché de modelos. Vacío = caché por defecto de Hugging Face. En docker: /models/whisper.
WHISPER_CACHE_DIR=

# --- Ingesta ---
# Por debajo de esta confianza el borrador lleva pregunta_aclaratoria.
UMBRAL_CONFIANZA=0.75
# Carpeta (relativa a backend/) de donde se leen audios y fotos de media_url (file://data/..., demo://...).
MEDIA_DIR=data

# --- Asistente ---
# true = el LLM redacta la respuesta con las cifras de las herramientas (se verifican); false = solo plantillas.
ASISTENTE_USAR_LLM=true
