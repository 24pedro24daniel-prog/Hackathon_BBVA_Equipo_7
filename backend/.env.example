# Copia este archivo a .env (el .env NO se sube al repo).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cajaclara
# Si lo dejas vacío, la API no exige X-API-Key (solo para desarrollo local).
API_KEY=cambia-esta-clave-de-demo
OLLAMA_URL=http://localhost:11434
WHISPER_MODEL=small
TZ=America/Lima
# "Hoy" de la demo: todos los cálculos usan core/reloj.py::hoy()
FECHA_DEMO=2026-11-14
CORS_ORIGINS=http://localhost:5173
