# TuCaserito backend — plantilla de credenciales (sí se versiona; NO pongas valores reales aquí).
#
# Cómo usarla:
#   1. Copia este archivo a backend/.env   (cp example.env .env)
#   2. Llena cada valor. backend/.env está en .gitignore y nunca se sube al repo.
#   3. Los parámetros no secretos (host, puerto, modelo, FECHA_DEMO...) están en parametros.env.

# Usuario y contraseña de PostgreSQL. docker compose los usa para crear la BD la primera vez.
# Si cambias la contraseña después de crear el volumen: docker compose down -v (borra los datos).
POSTGRES_USER=cajaclara
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Clave del header X-API-Key: acceso total (bot de WhatsApp y administración). El front ya NO la lleva (entra con el
# login de las demos y manda Authorization: Bearer).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Login de las demos (contract.md §12).
# AUTH_SECRET firma los tokens de sesión (HMAC-SHA256): al menos 32 caracteres aleatorios. Cambiarlo cierra todas las
# sesiones. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Usuarios de las demos: entradas USR-xx:<login>:<hash> separadas por coma. USR-xx es el usuario interno de
# AUTH_USUARIOS (parametros.env, usuario → empresa). El hash (scrypt con sal) se genera con:
#   python -m app.core.claves_demo --usuario USR-01 --login <login>      (pide la contraseña sin mostrarla)
# Las contraseñas nunca van en texto plano en el repo ni en el código.
AUTH_CREDENCIALES=

# Clave de OpenRouter (https://openrouter.ai/keys). Vacía = el extractor y el asistente usan su fallback.
OPENROUTER_API_KEY=

# Cloudflare R2 (audios y fotos): token S3 con permiso Object Read & Write sobre el bucket (ver README).
# Vacías = la subida de media responde 503; el resto de la API funciona igual (demo:// y file:// siguen sirviendo).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# BD de producción en Render: "External Database URL" del panel (postgresql://usuario:clave@host/base).
# Solo se usa con APP_ENV=produccion (variable de entorno del despliegue). Local, docker y tests usan el contenedor.
# El backend agrega el driver psycopg y sslmode=require. Nunca corras `app.db.reset` contra ella: usa `app.db.migrar`.
DATABASE_URL_PRODUCCION=
