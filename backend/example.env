# CajaClara backend — plantilla de credenciales (sí se versiona; NO pongas valores reales aquí).
#
# Cómo usarla:
#   1. Copia este archivo a backend/.env   (cp example.env .env)
#   2. Llena cada valor. backend/.env está en .gitignore y nunca se sube al repo.
#   3. Los parámetros no secretos (host, puerto, modelo, FECHA_DEMO...) están en parametros.env.

# Usuario y contraseña de PostgreSQL. docker compose los usa para crear la BD la primera vez.
# Si cambias la contraseña después de crear el volumen: docker compose down -v (borra los datos).
POSTGRES_USER=cajaclara
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Clave que el front y el bot mandan en el header X-API-Key.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Pon la misma en frontend/.env como VITE_API_KEY.
API_KEY=

# Clave de OpenRouter (https://openrouter.ai/keys). Vacía = el extractor y el asistente usan su fallback.
OPENROUTER_API_KEY=
