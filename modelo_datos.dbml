// TuCaserito — Modelo de datos (v2)
// Visualizar en https://dbdiagram.io (pegar este archivo).
// Diccionario de datos: diccionario_datos.md
// Fuente de verdad del esquema en la BD: backend/app/db/models.py (27 tablas: las 25 de este modelo + idempotency_keys
// y llm_llamadas). data/schema.sql y data/schema_esquema.json se GENERAN desde models.py; los CSV de data/csv se cargan con
// data/load_postgres.py o con `python -m app.db.cargar_csv`.
// Todos los datos son sintéticos. Montos en PEN con DECIMAL(12,2). Fechas con hora en timestamptz (America/Lima).
// Campos calculados (saldo, monto pendiente, días de atraso, estados por vencer/vencido) NO se guardan y TAMPOCO hay
// vistas en la BD: el backend los calcula en Python (backend/app/services/finanzas/consultas.py).

Project TuCaserito {
  database_type: 'PostgreSQL'
  Note: 'Gestor financiero para bodegas y pymes no bancarizadas. Entidad central: empresas.'
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENUMS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Enum tipo_flujo {
  ingreso
  egreso
}

Enum tipo_movimiento {
  venta              [note: 'ingreso · al contado o fiada (metodo_pago = credito)']
  cobro_fiado        [note: 'ingreso · un cliente paga (total o parcial) un fiado']
  prestamo_recibido  [note: 'ingreso · entra dinero prestado (gota a gota, familiar, entidad)']
  otro_ingreso       [note: 'ingreso · ingresos recurrentes u otros']
  compra             [note: 'egreso · al contado o a crédito (metodo_pago = credito)']
  gasto_negocio      [note: 'egreso · luz, agua, alquiler, transporte']
  retiro_personal    [note: 'egreso · plata que sale del negocio para la casa (incluye el sueldo)']
  pago_proveedor     [note: 'egreso · pago (total o parcial) de un pedido a crédito']
  pago_prestamo      [note: 'egreso · cuota de un préstamo de dinero']
  pago_impuesto      [note: 'egreso · pago de Nuevo RUS u otro tributo']
}

Enum metodo_pago {
  efectivo
  billetera_digital
  transferencia
  tarjeta
  credito [note: 'no mueve caja: fiado (venta) o pedido a crédito (compra)']
}

Enum canal_registro {
  voz
  texto
  foto
  billetera_api
  manual [note: 'formulario web']
}

Enum origen_monto {
  dicho_por_usuario
  catalogo
  estimado
}

Enum estado_borrador {
  pendiente
  confirmado
  descartado
}

Enum tipo_deuda {
  proveedor          [note: 'pedido de mercadería a crédito']
  prestamo_informal  [note: 'gota a gota u otro prestamista']
  familiar
  entidad_financiera
}

Enum frecuencia {
  diaria
  semanal
  quincenal
  mensual
}

Enum origen_billetera {
  api
  captura
}

Enum plantilla_meta {
  registrar_30_dias
  sueldo_fijo
  colchon_caja
  apartar_para_pedido
  reservar_impuestos
}

Enum tipo_regla {
  porcentaje_de_venta
  monto_fijo
}

Enum estado_meta {
  activa
  lograda
  pausada
}

Enum tipo_alerta {
  faltante_caja
  pedido_excesivo
  retiro_excesivo
  obligacion_proxima
  gasto_inusual
  caida_ventas
  fiado_vencido
  meta_lograda
  resumen_semanal
}

Enum nivel_riesgo {
  bajo
  medio
  alto
}

Enum canal_notificacion {
  whatsapp
  app
  email
}

Enum estado_alerta {
  activa
  atendida
  descartada
}

Enum rol_mensaje {
  usuario
  asistente
}

Enum perfil_pago {
  puntual
  ocasional
  moroso
}

Enum tipo_evento {
  cliente_no_paga
  mes_bajo
  alza_proveedor
  gasto_extra
  retiro_excesivo
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MAESTRAS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Table rubros {
  rubro_id varchar(20) [pk]
  nombre varchar(50) [not null, unique, note: 'bodega, restaurante, taller, distribuidora (los rubros de los modelos de ML)']
}

Table empresas {
  empresa_id varchar(20) [pk, note: 'EMP-0001']
  rubro_id varchar(20) [not null, ref: > rubros.rubro_id]
  nombre_ficticio varchar(100) [not null]
  telefono_whatsapp varchar(20) [not null, unique, note: 'Ficticio. Enruta los mensajes del webhook a la empresa']
  zona varchar(50) [not null, note: 'Zona o distrito: Lima Este, Lima Norte, Lima Sur, Callao…']
  n_trabajadores smallint [not null, default: 1, note: '1 a 5 (CHECK >= 1)']
  tiene_ruc boolean [not null, default: false, note: 'Estadio 3: formalización']
  ruc varchar(11) [unique, note: 'RUC de persona natural: 10 + 9 dígitos (CHECK ^10[0-9]{9}$). Null si no tiene. No lo usa el backend']
  regimen_tributario varchar(20) [note: 'nuevo_rus, null si es informal']
  saldo_inicial decimal(12,2) [not null, note: 'CHECK >= 0']
  fecha_saldo_inicial date [not null]
  minimo_operativo decimal(12,2) [not null]
  fecha_alta timestamptz [not null]
  Note: '''
  El sueldo fijo NO vive aquí: es un movimiento_programado con es_sueldo = true.
  usa_fiado y usa_billetera_digital (features del modelo de ML de forecast) NO se guardan aquí:
  se calculan en el backend (regla: >= 1 registro en los últimos 90 días; ver el final de este archivo).
  CHECKs: n_trabajadores >= 1, minimo_operativo >= 0, saldo_inicial >= 0, ruc IS NULL OR ruc ~ '^10[0-9]{9}$'.
  Todos los RUC de data/csv pasan el dígito verificador módulo 11 de SUNAT.
  '''
}

Table preferencias_alertas {
  empresa_id varchar(20) [pk, ref: - empresas.empresa_id]
  canales json [not null, note: '["whatsapp"]']
  max_por_dia smallint [not null, default: 2]
  silencio_desde time [not null, default: '21:00']
  silencio_hasta time [not null, default: '07:00']
  resumen_semanal boolean [not null, default: true]
}

Table categorias {
  categoria_id varchar(20) [pk]
  nombre varchar(50) [not null, unique, note: 'snake_case: bebidas, abarrotes, servicios, impuestos, retiro_personal, cobro_fiados, prestamos_recibidos, otros_gastos… (16 en total)']
  tipo tipo_flujo [not null]
  es_del_negocio boolean [not null, default: true, note: 'false para retiro_personal (no cuenta como gasto del negocio)']
  Note: '''
  No hay categorías de gastos del hogar: lo único personal que se registra es el retiro personal desde la caja del negocio (context.md §3, Alcance).
  Catálogo (16): CAT-01 bebidas, CAT-02 abarrotes, CAT-03 lacteos_panaderia, CAT-04 limpieza_aseo, CAT-05 snacks_golosinas,
  CAT-06 otros_ingresos, CAT-14 cobro_fiados, CAT-15 prestamos_recibidos (ingresos) · CAT-07 mercaderia, CAT-08 servicios,
  CAT-09 alquiler_local, CAT-10 transporte_flete, CAT-11 impuestos, CAT-12 financiamiento, CAT-13 retiro_personal, CAT-16 otros_gastos (egresos).
  El backend compara los nombres sin tildes, en minúsculas y con "_" igual a espacio.
  '''
}

Table productos {
  producto_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  categoria_id varchar(20) [not null, ref: > categorias.categoria_id]
  nombre varchar(100) [not null]
  alias json [note: '["chela", "cerveza grande"] para que el extractor encuentre el producto']
  precio_venta decimal(12,2) [not null]
  costo_unitario decimal(12,2) [note: 'null si no se conoce: la ganancia se muestra como rango']
  activo boolean [not null, default: true]
}

Table clientes {
  cliente_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  nombre_ficticio varchar(100) [not null, note: '"Sra. Carmen", "Don Luis"']
  alias json [note: 'Variantes del nombre para emparejar lo que dice la voz o el OCR']
  telefono_ficticio varchar(20) [note: 'Para el botón "Enviar recordatorio"']
  perfil_pago perfil_pago [note: 'OCULTO: solo lo usa el generador sintético. Nunca es feature']
  creado_en timestamptz [not null]
}

Table proveedores {
  proveedor_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  nombre_ficticio varchar(100) [not null, note: '"Distribuidora Andina"']
  telefono_ficticio varchar(20)
  plazo_pago_dias smallint [not null]
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// INGESTA Y TRANSACCIONES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Table borradores {
  borrador_id varchar(20) [pk, note: 'BOR-7781']
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  mensaje_id varchar(20) [ref: > conversaciones.mensaje_id, note: 'Mensaje que lo originó (null si es formulario)']
  canal canal_registro [not null]
  media_url varchar(255) [note: 'Audio o foto. Null si es texto o formulario']
  texto_original text [note: 'Texto escrito o transcripción de Whisper']
  payload_propuesto json [not null, note: 'Lo que entendió el extractor. Una foto del cuaderno trae la clave `fiados` (lista de {cliente, detalle, monto, fecha, confianza}); un movimiento trae tipo, items, monto…']
  origen_monto origen_monto
  confianza decimal(4,3) [note: '0 a 1']
  campos_faltantes json
  pregunta_aclaratoria text
  correcciones json [note: 'Lo que corrigió el usuario. Base de la métrica % de registros corregidos']
  estado estado_borrador [not null, default: 'pendiente']
  modelo_version varchar(30)
  prompt_version varchar(30)
  fallback_usado boolean [not null, default: false]
  creado_en timestamptz [not null]
  resuelto_en timestamptz
}

Table transacciones {
  transaccion_id varchar(20) [pk, note: 'MOV-000123']
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  borrador_id varchar(20) [ref: > borradores.borrador_id, note: 'Null si es formulario o API']
  fecha_hora timestamptz [not null]
  tipo tipo_movimiento [not null]
  categoria_id varchar(20) [not null, ref: > categorias.categoria_id]
  descripcion varchar(255)
  monto decimal(12,2) [not null, note: 'Siempre positivo; el signo sale de tipo']
  moneda char(3) [not null, default: 'PEN']
  metodo_pago metodo_pago [not null]
  afecta_caja boolean [not null, note: 'false cuando metodo_pago = credito (fiado o pedido a crédito)']
  canal canal_registro [not null]
  confianza_extraccion decimal(4,3) [note: 'Null si es manual o billetera_api']
  fue_corregida boolean [not null, default: false]
  fiado_id varchar(20) [ref: > cuaderno_fiado.fiado_id]
  deuda_id varchar(20) [ref: > deudas.deuda_id]
  impuesto_id varchar(20) [unique, ref: - impuestos.impuesto_id]
  programado_id varchar(20) [ref: > movimientos_programados.programado_id]
  billetera_mov_id varchar(20) [unique, ref: - billeteras_digitales.billetera_mov_id]
  anulada boolean [not null, default: false, note: 'Nunca se borra: se anula (trazabilidad)']
  creado_en timestamptz [not null]

  indexes {
    (empresa_id, fecha_hora)
    (empresa_id, tipo)
  }

  Note: '''
  Saldo de caja = empresas.saldo_inicial + Σ monto (con signo) de transacciones con afecta_caja = true y anulada = false.
  CHECKs:
  - monto > 0
  - afecta_caja = (metodo_pago <> 'credito')
  - a lo más una de fiado_id, deuda_id, impuesto_id, programado_id puede estar llena
  - tipo IN (cobro_fiado) → fiado_id NOT NULL; tipo IN (pago_proveedor, pago_prestamo, prestamo_recibido) → deuda_id NOT NULL; tipo = pago_impuesto → impuesto_id NOT NULL
  - tipo = venta y metodo_pago = credito → fiado_id NOT NULL; tipo = compra y metodo_pago = credito → deuda_id NOT NULL
  - moneda = 'PEN'; confianza_extraccion entre 0 y 1
  Categoría por defecto según el tipo cuando no hay producto ni categoría explícita: venta → otros_ingresos, cobro_fiado → cobro_fiados,
  prestamo_recibido → prestamos_recibidos, otro_ingreso → otros_ingresos, compra y pago_proveedor → mercaderia, gasto_negocio → otros_gastos,
  retiro_personal → retiro_personal, pago_prestamo → financiamiento, pago_impuesto → impuestos.
  '''
}

Table detalle_transaccion {
  detalle_id varchar(20) [pk]
  transaccion_id varchar(20) [not null, ref: > transacciones.transaccion_id]
  producto_id varchar(20) [ref: > productos.producto_id, note: 'Null si el producto no está en el catálogo']
  descripcion varchar(100) [note: 'Texto libre si no hay producto_id']
  cantidad decimal(10,3) [not null, note: 'Entera en data/csv (CHECK > 0); la columna admite fracciones (kilos) para registros reales']
  precio_unitario decimal(12,2) [not null]
  costo_unitario decimal(12,2) [note: 'Copia del costo al momento de la venta (margen histórico). CHECK >= 0']
  subtotal decimal(12,2) [not null, note: 'cantidad × precio_unitario']
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CUENTAS POR COBRAR Y POR PAGAR
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Table cuaderno_fiado {
  fiado_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  cliente_id varchar(20) [not null, ref: > clientes.cliente_id]
  borrador_id varchar(20) [ref: > borradores.borrador_id]
  detalle varchar(255) [note: '"2 panes, 1 leche"']
  monto decimal(12,2) [not null]
  fecha_fiado date [not null]
  fecha_compromiso date [note: 'Cuándo prometió pagar. Null si no se pactó']
  fecha_pago_total date [note: 'Fecha en que terminó de pagar. Null si aún debe']
  canal canal_registro [not null]
  pago_tardio boolean [note: 'ETIQUETA: solo para evaluar. Nunca es feature']

  indexes {
    (empresa_id, cliente_id)
  }

  Note: 'monto_pendiente, dias_atraso y estado se calculan en el backend a una fecha de corte (consultas.cuentas_fiado): monto − Σ cobro_fiado; sin fecha_compromiso se asumen 14 días.'
}

Table deudas {
  deuda_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  tipo tipo_deuda [not null]
  proveedor_id varchar(20) [ref: > proveedores.proveedor_id, note: 'Obligatorio si tipo = proveedor']
  acreedor_nombre varchar(100) [note: '"prestamista", "mi hermano". Para tipos distintos de proveedor']
  borrador_id varchar(20) [ref: > borradores.borrador_id]
  monto_recibido decimal(12,2) [not null, note: 'Dinero recibido o mercadería valorizada']
  monto_total_a_pagar decimal(12,2) [not null, note: 'Incluye intereses. Permite mostrar el costo real']
  frecuencia_cuota frecuencia [note: 'diaria en gota a gota. Null si es un solo pago']
  monto_cuota decimal(12,2)
  fecha_inicio date [not null]
  fecha_vencimiento date [not null, note: 'Fecha del último pago pactado']
  fecha_pago_total date [note: 'Null mientras siga pendiente']
  canal canal_registro [not null]
  notas varchar(255)

  indexes {
    (empresa_id, fecha_vencimiento)
  }

  Note: '''
  CHECKs: (tipo = 'proveedor') = (proveedor_id IS NOT NULL); monto_total_a_pagar >= monto_recibido; fecha_vencimiento >= fecha_inicio.
  monto_pendiente y estado (pendiente / por_vencer / vencido / pagado) se calculan en el backend (consultas.cuentas_deuda); por_vencer = vence en <= 3 días.
  '''
}

Table billeteras_digitales {
  billetera_mov_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  proveedor_billetera varchar(30) [not null]
  operacion_id varchar(50) [not null, note: 'ID del proveedor de la billetera']
  tipo tipo_flujo [not null]
  monto decimal(12,2) [not null]
  contraparte_nombre varchar(100)
  fecha_hora timestamptz [not null]
  origen origen_billetera [not null]

  indexes {
    (empresa_id, proveedor_billetera, operacion_id) [unique, note: 'Evita duplicados']
  }
}

Table impuestos {
  impuesto_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  regimen varchar(20) [not null, note: 'nuevo_rus']
  periodo char(7) [not null, note: 'AAAA-MM']
  monto decimal(12,2) [not null]
  fecha_vencimiento date [not null]
  fecha_pago date [note: 'Null si no se ha pagado']
  canal canal_registro [not null]

  indexes {
    (empresa_id, regimen, periodo) [unique]
  }

  Note: 'Semáforo al_dia / vencido calculado en el backend (consultas.cuentas_impuesto).'
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// PLANIFICACIÓN: RECURRENTES, SUELDO, METAS Y AJUSTES
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Table movimientos_programados {
  programado_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  categoria_id varchar(20) [not null, ref: > categorias.categoria_id]
  tipo tipo_flujo [not null]
  descripcion varchar(100) [not null, note: 'luz, agua, alquiler del local, sueldo, venta fija a un comedor. Nunca gastos o ingresos del hogar']
  monto decimal(12,2) [not null]
  frecuencia frecuencia [not null]
  dia_semana smallint [note: '1 = lunes … 7 = domingo. Para semanal']
  dia_mes smallint [note: '1 a 31. Para quincenal (primer día) y mensual']
  es_sueldo boolean [not null, default: false, note: 'Sueldo fijo del dueño (egreso, categoría retiro_personal). Puede ser semanal, quincenal o mensual']
  fecha_inicio date [not null]
  fecha_fin date [note: 'Null si sigue vigente. Cambiar el sueldo = cerrar este y abrir otro']
  activo boolean [not null, default: true]

  Note: '''
  Única fuente del sueldo fijo y de los ingresos/egresos recurrentes. El forecast los proyecta.
  El sueldo semanal/diario se compara por ocurrencias; el mensual/quincenal se prorratea por día al evaluar retiro_excesivo (consultas.sueldo_esperado).
  Índice único parcial: un solo sueldo activo por empresa → UNIQUE (empresa_id) WHERE es_sueldo AND activo.
  '''
}

Table reglas_meta {
  meta_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  plantilla plantilla_meta [not null]
  programado_id varchar(20) [ref: > movimientos_programados.programado_id, note: 'Para sueldo_fijo: el movimiento programado (es_sueldo = true) que se compromete a respetar']
  tipo_regla tipo_regla
  valor decimal(12,4) [note: '0.10 = 10% de cada venta, o monto fijo (sueldo_fijo: tipo_regla = monto_fijo y valor = monto del sueldo)']
  destino varchar(30) [note: 'fondo_pedidos, fondo_impuestos, colchon']
  objetivo decimal(12,2) [note: 'Monto o días meta. Null si no aplica']
  acumulado decimal(12,2) [not null, default: 0, note: 'Apartado virtual: no sale de la caja']
  recordatorio_frecuencia frecuencia
  recordatorio_dia smallint
  estado estado_meta [not null, default: 'activa']
  fecha_inicio date [not null]
  fecha_logro date
}

Table forecast_ajustes {
  ajuste_id varchar(20) [pk, note: 'AJU-0003']
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  programado_id varchar(20) [ref: > movimientos_programados.programado_id, note: 'Si ajusta un recurrente']
  fecha date [not null]
  concepto varchar(100) [not null]
  monto decimal(12,2) [not null, note: '0 = no se paga ese mes']
  motivo varchar(255)
  activo boolean [not null, default: true]
  creado_en timestamptz [not null]
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ALERTAS, CONVERSACIÓN Y CONSENTIMIENTO
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Table alertas {
  alerta_id varchar(20) [pk, note: 'ALR-0007']
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  tipo tipo_alerta [not null]
  prioridad smallint [not null, note: '1 (faltante de caja) a 8 (resumen semanal). CHECK entre 1 y 8']
  fecha_evento date [not null, note: 'Cuándo ocurriría el problema']
  monto decimal(12,2)
  probabilidad decimal(4,3)
  nivel_riesgo nivel_riesgo
  causas json [note: 'Lista de {descripcion, monto}: [{"descripcion": "Sacaste más de la caja de lo usual", "monto": 700}]. pedido_excesivo trae 2 (lo que pediste y lo que sueles vender); retiro_excesivo trae 2 (lo que sacaste y la referencia); faltante_caja trae 1 o más: nadie debe asumir un índice']
  accion_sugerida varchar(50) [note: 'Valores del backend: abrir_simulador, ver_retiros, ver_cuentas, recordar_cliente…']
  entidad_tipo varchar(30) [note: 'Tabla en plural: cuaderno_fiado, deudas, impuestos, transacciones, reglas_meta; o `mes` para alertas agregadas por periodo (retiro_excesivo, con entidad_id = AAAA-MM)']
  entidad_id varchar(20) [note: 'Registro que causa la alerta (lo usa el botón de acción) o el mes AAAA-MM']
  canal canal_notificacion [not null]
  estado estado_alerta [not null, default: 'activa']
  accion_tomada varchar(50) [note: 'Null si no tomó ninguna. Base de la métrica % alertas con acción']
  fecha_accion timestamptz
  creada_en timestamptz [not null]
  enviada_en timestamptz [note: 'Null si quedó retenida por max_por_dia u horario silencioso']
  modelo_version varchar(30) [note: 'lgbm_cuantiles-1.0 (forecast) o reglas-alertas-0.1.0 (reglas determinísticas)']
}

Table conversaciones {
  mensaje_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  conversacion_id varchar(20) [not null]
  rol rol_mensaje [not null]
  canal canal_notificacion [not null]
  texto text
  media_url varchar(255)
  intencion varchar(50) [note: 'Valores de IntencionAsistente: estado_caja, explicar_alerta, simular, concepto, crear_meta, prestamo, fuera_de_alcance, otro']
  herramientas_llamadas json [note: 'Function calls del LLM y sus resultados']
  cifras_verificadas boolean [note: 'true si todas las cifras de la respuesta existen en los datos']
  fallback_usado boolean [not null, default: false]
  derivado_a_humano boolean [not null, default: false]
  prompt_version varchar(30)
  modelo_version varchar(30)
  fecha_hora timestamptz [not null]

  indexes {
    (empresa_id, conversacion_id, fecha_hora)
  }
}

Table consentimientos {
  consentimiento_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  alcance json [not null, note: '["resumen_12_meses", "score"]']
  activo boolean [not null, default: false]
  fecha_otorgado timestamptz
  vigencia_hasta date
  fecha_revocado timestamptz
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ETIQUETAS Y RESULTADOS (EVALUACIÓN Y TRAZABILIDAD)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Table saldo_diario {
  empresa_id varchar(20) [ref: > empresas.empresa_id]
  fecha date
  saldo_cierre decimal(12,2) [not null, note: 'Materializado desde transacciones; se regenera si llega un registro con fecha pasada']
  deficit_14d boolean [note: 'ETIQUETA: true si en los 14 días siguientes el saldo cae bajo el mínimo operativo. Nunca es feature. NULL cuando la ventana de 14 días pasa de la fecha de corte (no se conoce)']

  indexes {
    (empresa_id, fecha) [pk]
  }
}

Table eventos {
  evento_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  tipo_evento tipo_evento [not null]
  fecha_inicio date [not null]
  fecha_fin date [note: 'Null = evento en curso']
  descripcion varchar(255)
  Note: 'ETIQUETA (toda la tabla): shocks insertados por el generador. Ground truth, nunca feature. fecha_fin NULL = evento en curso a la fecha de corte.'
}

Table predicciones_saldo {
  prediccion_id varchar(20) [pk]
  empresa_id varchar(20) [not null, ref: > empresas.empresa_id]
  fecha_corte date [not null]
  fecha_objetivo date [not null]
  p10 decimal(12,2) [not null]
  p50 decimal(12,2) [not null]
  p90 decimal(12,2) [not null]
  modelo_version varchar(30) [not null, note: 'naive_estacional-1.0, lgbm_cuantiles-1.0 (metadata.json del artefacto)']
  creado_en timestamptz [not null]

  indexes {
    (empresa_id, fecha_corte, fecha_objetivo, modelo_version) [unique]
  }
}

Table predicciones_fiado {
  prediccion_id varchar(20) [pk]
  fiado_id varchar(20) [not null, ref: > cuaderno_fiado.fiado_id]
  fecha_corte date [not null]
  prob_atraso decimal(4,3) [not null]
  prob_pago_14d decimal(4,3) [note: 'Pondera el cobro esperado en el forecast']
  nivel_riesgo nivel_riesgo [not null, note: 'prob_atraso >= 0.6 alto, >= 0.3 medio, si no bajo (backend/app/services/finanzas/riesgo.py)']
  modelo_version varchar(30) [not null, note: 'baseline_historial-1.0 (tasa del cliente suavizada) o el clasificador cuando exista']
  creado_en timestamptz [not null]

  indexes {
    (fiado_id, fecha_corte, modelo_version) [unique]
  }
}

Table score_salud {
  empresa_id varchar(20) [ref: > empresas.empresa_id]
  mes char(7) [note: 'AAAA-MM']
  score smallint [not null, note: '0 a 100']
  subindicadores json [not null, note: '{"constancia_registro": 80, "separacion_personal": 55, "impuestos_al_dia": 100}: los 3 subindicadores del backend']
  version_formula varchar(30) [not null, note: 'score-v1: round(0.35·constancia_registro + 0.40·separacion_personal + 0.25·impuestos_al_dia) (services/salud/score.py)']

  indexes {
    (empresa_id, mes) [pk]
  }
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// GRUPOS (para el diagrama)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

TableGroup maestras {
  rubros
  empresas
  preferencias_alertas
  categorias
  productos
  clientes
  proveedores
}

TableGroup ingesta_y_transacciones {
  borradores
  transacciones
  detalle_transaccion
}

TableGroup cobrar_y_pagar {
  cuaderno_fiado
  deudas
  billeteras_digitales
  impuestos
}

TableGroup planificacion {
  movimientos_programados
  reglas_meta
  forecast_ajustes
}

TableGroup interaccion {
  alertas
  conversaciones
  consentimientos
}

TableGroup etiquetas_y_resultados {
  saldo_diario
  eventos
  predicciones_saldo
  predicciones_fiado
  score_salud
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TÉCNICA (no son parte del modelo de negocio): llm_llamadas e idempotency_keys
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Respuesta guardada por la cabecera Idempotency-Key (contrato §0): repetir la misma petición devuelve la misma respuesta.
Table idempotency_keys {
  clave varchar(100) [not null]
  endpoint varchar(120) [not null]
  empresa_id varchar(20) [note: 'Sin FK: es solo trazabilidad']
  payload_hash varchar(64) [not null, note: 'sha256 del cuerpo de la petición']
  status_code int [not null]
  respuesta json [not null]
  creado_en timestamptz [not null]

  indexes {
    (clave, endpoint) [pk]
  }
}

Table llm_llamadas {
  llamada_id varchar(20) [pk, note: 'LLM-000001']
  empresa_id varchar(20) [ref: > empresas.empresa_id]
  origen varchar(20) [not null, note: 'extractor | asistente | vision']
  referencia_tipo varchar(20) [note: 'borrador | mensaje']
  referencia_id varchar(20) [note: 'borradores.borrador_id o conversaciones.mensaje_id (sin FK: es polimórfica)']
  prompt_version varchar(30)
  proveedor varchar(30) [not null, default: 'openrouter']
  modelo_solicitado varchar(100)
  modelo_respondido varchar(100)
  generation_id varchar(100) [note: 'id de la respuesta de OpenRouter']
  request json [note: 'messages, tools, tool_choice, temperature, max_tokens. Imágenes como {imagen:{sha256,bytes,mime}}; nunca headers ni API key']
  respuesta json [note: 'content, tool_calls crudos y finish_reason']
  prompt_tokens int
  completion_tokens int
  total_tokens int
  costo_usd decimal(12,8) [note: 'usage.cost de OpenRouter']
  latencia_ms int
  estado varchar(20) [not null, note: 'ok | timeout | http_error | red | respuesta_invalida | sin_configurar']
  http_status smallint
  error text [note: 'mensaje corto, sin secretos']
  resultado_uso varchar(30) [note: 'aceptada | rechazada_validacion | rechazada_verificador']
  creado_en timestamptz [not null]

  indexes {
    (empresa_id, creado_en)
    (origen, creado_en)
  }
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CAMPOS CALCULADOS EN EL BACKEND (no hay vistas en la BD; esto es solo la definición de referencia)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// v_saldo_caja, v_fiados, v_deudas, v_impuestos, v_resumen_mes y v_disponible_gastar se calculan en Python
// (backend/app/services/finanzas/), a la fecha de corte que corresponda: saldo = saldo_inicial + Σ movimientos con
// afecta_caja; por_vencer = vence en <= 3 días; un fiado sin fecha_compromiso vence a los 14 días.
// data/schema.sql ya no define ninguna vista.
//
// Las dos "vistas" de abajo (v_empresas_flags y v_empresas_credit_features) son las FEATURES de los modelos de ML:
// TAMBIÉN se calculan en el backend (Python), no en SQL. El SQL de abajo es documentación de la regla acordada con el
// equipo de modelos; la implementación vive en el código de los modelos/backend.
//
// v_empresas_flags: usa_fiado / usa_billetera_digital para el modelo de ML de forecast
// (modelo/artifacts/prediccion_ingreso_egreso/). Regla acordada con el equipo de ML: true si
// hay >=1 registro en los últimos 90 días.
//
// (definición de referencia, no se crea en la BD)
// CREATE VIEW v_empresas_flags AS
// SELECT
//   e.empresa_id,
//   EXISTS (
//     SELECT 1 FROM cuaderno_fiado f
//     WHERE f.empresa_id = e.empresa_id AND f.fecha_fiado >= CURRENT_DATE - INTERVAL '90 days'
//   ) AS usa_fiado,
//   EXISTS (
//     SELECT 1 FROM billeteras_digitales b
//     WHERE b.empresa_id = e.empresa_id AND b.fecha_hora >= CURRENT_DATE - INTERVAL '90 days'
//   ) AS usa_billetera_digital
// FROM empresas e;
//
// v_empresas_credit_features: features de entrada del modelo de credit scoring (regresión
// logística, modelo/artifacts/credit_scoring/). Ventana de agregación: últimos 180 días
// (parámetro VENTANA_DIAS, ajustable). zona/rubro quedan con la misma observación que en
// v_empresas_flags/prediccion_ingreso_egreso: rubro usa la taxonomía real de `rubros`, zona
// es texto libre en la BD y todavía no tiene regla de mapeo acordada (el notebook de credit
// scoring aún simula zona con categorías propias, pendiente de alinear).
//
// (definición de referencia, no se crea en la BD)
// CREATE VIEW v_empresas_credit_features AS
// SELECT
//   e.empresa_id,
//   e.tiene_ruc,
//   EXTRACT(MONTH FROM AGE(CURRENT_DATE, e.fecha_alta))
//     + EXTRACT(YEAR FROM AGE(CURRENT_DATE, e.fecha_alta)) * 12 AS antiguedad_meses,
//   (SELECT COALESCE(AVG(t.monto), 0) FROM transacciones t
//     WHERE t.empresa_id = e.empresa_id AND t.tipo = 'venta'
//       AND t.fecha_hora >= CURRENT_DATE - INTERVAL '180 days') AS ingreso_mensual_prom,
//   -- pct_dias_con_venta, cv_ventas: % de días con >=1 venta y coeficiente de variación del
//   -- monto diario vendido, agregando transacciones.tipo = 'venta' por día en la ventana.
//   (SELECT COUNT(DISTINCT t.fecha_hora::date)::float / 180 FROM transacciones t
//     WHERE t.empresa_id = e.empresa_id AND t.tipo = 'venta'
//       AND t.fecha_hora >= CURRENT_DATE - INTERVAL '180 days') AS pct_dias_con_venta,
//   -- pct_pagos_a_tiempo, dias_mora_promedio: comparar deudas.fecha_pago_total (o CURRENT_DATE
//   -- si sigue pendiente) contra deudas.fecha_vencimiento, agregado por empresa_id.
//   (SELECT AVG((d.fecha_pago_total IS NOT NULL AND d.fecha_pago_total <= d.fecha_vencimiento)::int::float)
//     FROM deudas d WHERE d.empresa_id = e.empresa_id) AS pct_pagos_a_tiempo,
//   (SELECT AVG(GREATEST(COALESCE(d.fecha_pago_total, CURRENT_DATE) - d.fecha_vencimiento, 0))
//     FROM deudas d WHERE d.empresa_id = e.empresa_id) AS dias_mora_promedio,
//   (SELECT CURRENT_DATE - MAX(t.fecha_hora::date) FROM transacciones t
//     WHERE t.empresa_id = e.empresa_id) AS dias_desde_ultimo_registro,
//   -- pct_fiado_sobre_ventas: monto en cuaderno_fiado / monto en ventas, misma ventana.
//   -- pct_fiado_cobrado_a_tiempo: SOLO como tasa agregada (fecha_pago_total <= fecha_compromiso),
//   -- NUNCA el campo individual cuaderno_fiado.pago_tardio (reservado para evaluación).
//   (SELECT COALESCE(SUM(f.monto), 0) FROM cuaderno_fiado f
//     WHERE f.empresa_id = e.empresa_id AND f.fecha_fiado >= CURRENT_DATE - INTERVAL '180 days')
//     / NULLIF((SELECT SUM(t.monto) FROM transacciones t
//       WHERE t.empresa_id = e.empresa_id AND t.tipo = 'venta'
//         AND t.fecha_hora >= CURRENT_DATE - INTERVAL '180 days'), 0) AS pct_fiado_sobre_ventas,
//   (SELECT AVG((f.fecha_pago_total IS NOT NULL AND f.fecha_pago_total <= f.fecha_compromiso)::int::float)
//     FROM cuaderno_fiado f WHERE f.empresa_id = e.empresa_id) AS pct_fiado_cobrado_a_tiempo,
//   -- n_alertas_quiebre_stock: proxy vía alertas.tipo_alerta = 'caida_ventas' (no existe un tipo
//   -- quiebre_stock en el enum; agregarlo queda como mejora opcional).
//   (SELECT COUNT(*) FROM alertas a
//     WHERE a.empresa_id = e.empresa_id AND a.tipo = 'caida_ventas'
//       AND a.creada_en >= CURRENT_DATE - INTERVAL '180 days') AS n_alertas_quiebre_stock
// FROM empresas e;
