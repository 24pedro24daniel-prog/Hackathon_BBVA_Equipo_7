# false (por defecto) = llama al backend FastAPI. true = usa los mocks de src/mocks (demo sin backend; el login
# también funciona sin backend con las cuentas demo1/demo2/demo3).
VITE_USE_MOCK=false
# Base del backend. En dev, /api se proxea a VITE_PROXY_TARGET (ver vite.config.js).
# En producción (Vercel) es la URL absoluta del backend en Render: https://cajaclara-backend-ulah.onrender.com/api/v1
VITE_API_BASE=/api/v1
VITE_PROXY_TARGET=http://localhost:8000
# Solo modo mock: empresa de la cuenta demo1. Con backend real la empresa sale del token del login.
VITE_EMPRESA_ID=EMP-0001
# El front no lleva ninguna clave: entra con el login de las demos (Authorization: Bearer). Nunca pongas secretos en VITE_*.
