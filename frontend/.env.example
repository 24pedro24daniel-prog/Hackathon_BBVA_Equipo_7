# true = usa los mocks de src/mocks (contract.md). false = llama al backend FastAPI.
VITE_USE_MOCK=true
# Base del backend. En dev, /api se proxea a VITE_PROXY_TARGET (ver vite.config.js).
VITE_API_BASE=/api/v1
VITE_PROXY_TARGET=http://localhost:8000
VITE_EMPRESA_ID=EMP-0001
# Solo para la demo local. Nunca subir la clave real al repo.
VITE_API_KEY=
