# false (por defecto) = llama al backend FastAPI. true = usa los mocks de src/mocks (demo sin backend).
VITE_USE_MOCK=false
# Base del backend. En dev, /api se proxea a VITE_PROXY_TARGET (ver vite.config.js).
VITE_API_BASE=/api/v1
VITE_PROXY_TARGET=http://localhost:8000
VITE_EMPRESA_ID=EMP-0001
# Copia aquí el API_KEY de backend/.env. Nunca subir la clave real al repo.
VITE_API_KEY=
