        <mxCell id="svc-e39" edge="1" parent="1" source="svc-v21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="svc-v23" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;6&lt;/span&gt;&amp;nbsp;Guarda foto/audio">
