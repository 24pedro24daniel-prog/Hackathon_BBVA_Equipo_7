tch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="850" y="772" width="44" height="44" as="geometry"/></mxCell><mxCell id="svc-v30" value="CloudTrail" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1"><mxGeometry x="980" y="772" width="44" height="44" as="geometry"/></mxCell><mxCell id="svc-v31" value="GuardDuty" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;" vertex="1" parent="1"><mxGeometry x="1110" y="772" width="44" height="44" as="geometry"/></mxCell><mxCell id="svc-e32" value="DNS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A96A3;strokeWidth=1.2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#5A6B7B;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="svc-v11" target="svc-v12"><mxGeometry relative="1"   as="geometry"></mxGeometry></mxCell><mxCell id="svc-e33" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;1&lt;/span&gt;&amp;nbsp;HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc-v10" target="svc-v12"><mxGeometry relative="1" x="-0.15"  as="geometry"></mxGeometry></mxCell><mxCell id="svc-e34" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;2&lt;/span&gt;&amp;nbsp;Origen privado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="svc-v12" target="svc-v15"><mxGeometry relative="1"   as="geometry"></mxGeometry></mxCell><mxCell id="svc-e35" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;3&lt;/span&gt;&amp;nbsp;Web" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-v15" target="svc-v16"><mxGeometry relative="1" x="0.6"  as="geometry"><Array as="points"><mxPoint x="590" y="304"/><mxPoint x="590" y="271"/></Array></mxGeometry></mxCell><mxCell id="svc-e36" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;4&lt;/span&gt;&amp;nbsp;Inicia sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-v10" target="svc-v22"><mxGeometry relative="1" x="0.4"  as="geometry"></mxGeometry></mxCell><mxCell id="svc-e37" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;5&lt;/span&gt;&amp;nbsp;API · JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-v15" target="svc-v18"><mxGeometry relative="1" x="0.6"  as="geometry"><Array as="points"><mxPoint x="590" y="304"/><mxPoint x="590" y="411"/></Array></mxGeometry></mxCell><mxCell id="svc-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-v18" target="svc-v21"><mxGeometry relative="1"   as="geometry"></mxGeometry></mxCell><mxCell id="svc-e39" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;6&lt;/span&gt;&amp;nbsp;Guarda foto/audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-v21" target="svc-v23"><mxGeometry relative="1" x="0.55"  as="geometry"></mxGeometry></mxCell><mxCell id="svc-e40" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;7&lt;/span&gt;&amp;nbsp;Extrae datos (IA)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-v21" target="svc-v24"><mxGeometry relative="1" x="0.15"  as="geometry"><Array as="points"><mxPoint x="800" y="600"/><mxPoint x="904" y="600"/></Array></mxGeometry></mxCell><mxCell id="svc-e41" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:9px;padding:1px 6px;font-weight:bold;&quot;&gt;8&lt;/span&gt;&amp;nbsp;Guarda datos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.6;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc-v18" target="svc-v20"><mxGeometry relative="1"   as="geometry"></mxGeometry></mxCell><mxCell id="svc-v42" value="&lt;b&gt;Seguridad de red&lt;/b&gt;&lt;br&gt;• CloudFront + WAF (reglas OWASP, rate limit) + Shield (DDoS)&lt;br&gt;• ALB solo acepta tráfico de CloudFront (prefix list + header secreto)&lt;br&gt;• Contenedores y BD en subredes privadas, sin IP pública y sin NAT&lt;br&gt;• Security Groups encadenados: ALB→Front :80 · ALB→Back :8000 · Back→RDS :5432&lt;br&gt;• Servicios AWS solo vía VPC Endpoints (PrivateLink / Gateway S3)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxGeometry x="150" y="940" width="560" height="150" as="geometry"/></mxCell><mxCell id="svc-v43" value="&lt;b&gt;Seguridad de datos&lt;/b&gt;&lt;br&gt;• TLS 1.2+ en todo el tránsito (certificados ACM)&lt;br&gt;• Cifrado en reposo con KMS: RDS, S3, logs y backups&lt;br&gt;• S3 privado (Block Public Access) + URLs prefirmadas de 10 min por empresa&lt;br&gt;• Credenciales en Secrets Manager con rotación; nada dentro de la imagen&lt;br&gt;• Cognito (JWT) por usuario · IAM task roles de mínimo privilegio · CloudTrail + GuardDuty" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#DD344C;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;arcSize=3;" vertex="1" parent="1"><mxG